<?xml version="1.0"?>
<package format="3">
  <name>so101_perception</name>
  <version>0.1.0</version>
  <description>Overhead camera and ArUco cube pose for the SO-101 (publishes /object_pose in base_link).</description>
  <maintainer email="bhavarthkokane25@gmail.com">Bhavarth Kokane</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>usb_cam</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
