<?xml version="1.0"?>
<package format="3">
  <name>so101_policy_bridge</name>
  <version>0.1.0</version>
  <description>Runs the SO-101 pick-and-place RL policy (ONNX) on ROS 2 joint states and object pose.</description>
  <maintainer email="bhavarthkokane25@gmail.com">Bhavarth Kokane</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>so101_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
